# SPEC006: mechanical validation, Node22 and native dependencies; no deployed service.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tesseract-ocr tesseract-ocr-spa tesseract-ocr-eng poppler-utils libreoffice-writer fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci && npm audit --omit=dev --audit-level=high
COPY scripts/cache-validation-models.mjs /app/cache-validation-models.mjs
RUN node /app/cache-validation-models.mjs
COPY tsconfig.json tsconfig.check.json ./
COPY src ./src
COPY scripts ./scripts
COPY test ./test
COPY config ./config
COPY migrations ./migrations
COPY db ./db
RUN mkdir -p /app/.cache /app/var && chown node:node /app/.cache /app/var
USER node
ENV NODE_ENV=test
# No AWS credentials, corpus, Docker socket or host mounts in the runtime.
CMD ["npm", "run", "test:validation-integration"]
