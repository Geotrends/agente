{
  "name": "agent-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test:integration": "npm run test:di-integration",
    "baseline:queries": "tsx scripts/extract-queries.ts",
    "baseline:capture": "tsx scripts/capture-baseline.ts",
    "baseline:check": "tsx scripts/check-baseline.ts",
    "bench:stages": "node --import tsx scripts/bench-stages.ts",
    "bench:rerank": "node --import tsx scripts/bench-rerank.ts",
    "golden:candidates": "node --import tsx scripts/build-golden-candidates.ts",
    "golden:finalize": "node --import tsx scripts/finalize-golden-set.ts",
    "eval:retrieval": "node --import tsx scripts/eval-retrieval.ts",
    "test:all": "npm test && npm run test:seguridad-008 && npm run test:di-integration && npm run test:ui-integration && npm run test:in-integration && npm run test:kb-integracion",
    "kb": "node --import tsx src/kb/cli.ts",
    "test:kb-integracion": "node --import tsx --test --test-concurrency=1 test/kb-integracion/*.test.ts",
    "test:di-integration": "node --import tsx --test --test-concurrency=1 test/di-integracion/*.test.ts",
    "eval:injection": "node --import tsx scripts/eval-injection.ts",
    "check:iam": "node --import tsx scripts/check-iam-policy.ts",
    "eval:tokenizer": "node --import tsx scripts/eval-tokenizer.ts",
    "eval:di": "node --import tsx scripts/eval-di.ts",
    "eval:di-traffic": "node --import tsx scripts/eval-di-traffic.ts",
    "eval:di-load": "node --import tsx scripts/eval-di-load.ts",
    "eval:di-host": "node --import tsx scripts/eval-di-host.ts",
    "in-collect": "node --import tsx scripts/in-collect-results.ts",
    "report:in": "node --import tsx scripts/report-in.ts",
    "scan:secrets": "node --import tsx scripts/scan-secrets.ts",
    "test:ui-integration": "node --import tsx --test --test-concurrency=1 test/ui-integracion/*.test.ts",
    "test:in-integration": "node --import tsx --test --test-concurrency=1 test/in-integracion/*.test.ts",
    "admin:migrate": "node --import tsx scripts/migrate-admin.ts",
    "admin:recover": "node --import tsx scripts/recover-admin.ts",
    "test:admin": "node --import tsx --test test/admin-*.test.ts",
    "test:admin-integration": "node --import tsx --test --test-concurrency=1 test/admin-integracion/*.test.ts",
    "eval:admin-performance": "node --import tsx scripts/eval-admin-performance.ts",
    "test:seguridad-008": "node --import tsx --test --test-concurrency=1 test/seguridad-008/*.test.ts",
    "test:validation": "node --import tsx --test test/validation-*.test.ts",
    "test:validation-integration": "node --import tsx --test --test-concurrency=1 test/validation-integracion/*.test.ts",
    "validation:check": "node --import tsx scripts/validation.ts check",
    "validation:freeze": "node --import tsx scripts/validation.ts freeze",
    "validation:review": "node --import tsx scripts/validation.ts review",
    "validation:report": "node --import tsx scripts/validation.ts report",
    "validation:acta": "node --import tsx scripts/validation.ts acta"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1148.0",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "^4.3.0",
    "@qdrant/js-client-rest": "~1.19.0",
    "argon2": "^0.45.1",
    "busboy": "1.6.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "js-tiktoken": "1.0.21",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "undici": "^7.30.0"
  }
}
