{
  "name": "agent-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "index": "tsx src/indexDocuments.ts",
    "test:integration": "node --import tsx test/http-smoke.ts",
    "test:providers": "node --import tsx test/smoke.ts",
    "baseline:queries": "tsx scripts/extract-queries.ts",
    "baseline:capture": "tsx scripts/capture-baseline.ts",
    "baseline:check": "tsx scripts/check-baseline.ts",
    "bench:retrieval": "node --expose-gc --import tsx scripts/bench-retrieval.ts",
    "probe:rebuild": "node --import tsx scripts/probe-rebuild-oom.ts",
    "bench:worker": "node --import tsx scripts/bench-worker.ts",
    "bench:stages": "node --import tsx scripts/bench-stages.ts",
    "bench:rerank": "node --import tsx scripts/bench-rerank.ts",
    "golden:candidates": "node --import tsx scripts/build-golden-candidates.ts",
    "golden:finalize": "node --import tsx scripts/finalize-golden-set.ts",
    "eval:retrieval": "node --import tsx scripts/eval-retrieval.ts",
    "extraction:gaps": "node --import tsx scripts/summarize-extraction-gaps.ts",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "^4.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
