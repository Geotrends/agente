PORT=3001

# Carpeta local con todos los documentos (recursivo). Relativa al backend o absoluta.
# Cada subcarpeta directa dentro de data/ aparece como "Biblioteca" en la UI (ej. data/ESTANDARES, data/MI_CARPETA).
GEOTRENDS_DOCUMENTS_ROOT=data

# Gemini
GEMINI_API_KEY=
# Modelo predeterminado. GEMINI_MODELS define todos los modelos seleccionables,
# separados por comas; agrega aqui los IDs habilitados para tu cuenta.
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODELS=gemini-flash-latest

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODELS=llama-3.1-8b-instant
# Opcional: max caracteres del texto del documento activo enviados a Groq (evita HTTP 413). Por defecto 18000; si aun falla, prueba 12000.
# GROQ_MAX_DOCUMENT_CHARS=18000

# Ollama (servicio local, por defecto http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Espera maxima de Ollama (hallazgo M-10). Era el unico de los cinco
# proveedores sin timeout: si el servicio local se colgaba, la peticion del
# ciudadano esperaba indefinidamente. El defecto es mas generoso que los 60 s de
# los proveedores remotos a proposito, porque Ollama genera en la CPU de la
# misma maquina y una respuesta larga puede tardar de verdad.
# OLLAMA_TIMEOUT_MS=120000
OLLAMA_MODEL=llama3.2
# Ejemplo con varios modelos locales: OLLAMA_MODELS=llama3.2,qwen2.5
OLLAMA_MODELS=llama3.2

# DeepSeek (https://platform.deepseek.com/api_keys) — API compatible OpenAI; billing por uso
DEEPSEEK_API_KEY=
# Opcional: por defecto https://api.deepseek.com/chat/completions
# DEEPSEEK_API_URL=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODELS=deepseek-v4-flash

# OpenAI (https://platform.openai.com/api-keys) — billing por uso. Los modelos
# de razonamiento (familia gpt-5) fijan la temperatura por defecto; el backend
# no envia un valor propio para funcionar con cualquier modelo que agregues aqui.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_MODELS=gpt-5-nano

# Convencion multimodelo para todos los proveedores:
# - *_MODEL  = modelo usado por defecto para ese proveedor.
# - *_MODELS = catalogo permitido y visible en el selector, separado por comas.
# El backend rechaza cualquier modelo recibido que no aparezca en ese catalogo.

# Enrutamiento automatico por complejidad. Cada modelo debe aparecer tambien
# en el *_MODELS del proveedor correspondiente. El fallback se usa si falta la
# configuracion del principal o si este devuelve un error reconocido.
AUTO_ROUTE_SIMPLE_PROVIDER=groq
AUTO_ROUTE_SIMPLE_MODEL=llama-3.1-8b-instant
AUTO_ROUTE_SIMPLE_FALLBACK_PROVIDER=gemini
AUTO_ROUTE_SIMPLE_FALLBACK_MODEL=gemini-flash-latest

AUTO_ROUTE_MEDIUM_PROVIDER=groq
AUTO_ROUTE_MEDIUM_MODEL=llama-3.1-8b-instant
AUTO_ROUTE_MEDIUM_FALLBACK_PROVIDER=gemini
AUTO_ROUTE_MEDIUM_FALLBACK_MODEL=gemini-flash-latest

AUTO_ROUTE_COMPLEX_PROVIDER=deepseek
AUTO_ROUTE_COMPLEX_MODEL=deepseek-v4-flash
AUTO_ROUTE_COMPLEX_FALLBACK_PROVIDER=gemini
AUTO_ROUTE_COMPLEX_FALLBACK_MODEL=gemini-flash-latest

# Reintentos ante fallos transitorios de proveedor (hallazgo M-10). Solo se
# reintenta lo que la clasificacion de A-4 marca como reintentable: red, 5xx y
# saturacion (429). Un 401, un modelo inexistente o una peticion demasiado
# grande se devuelven al primer intento, porque repetirlos da el mismo error.
# ATTEMPTS son intentos TOTALES, no reintentos: 2 = uno y, si falla, otro.
# Si el proveedor manda Retry-After se respeta esa espera, acotada por MAX_MS.
# PROVIDER_RETRY_ATTEMPTS=2
# PROVIDER_RETRY_BASE_MS=500
# PROVIDER_RETRY_MAX_MS=4000

# Todas las variables numericas de este archivo se leen por un solo camino
# validado (services/config.ts, hallazgo M-8): un valor no numerico cae al
# defecto y AVISA por consola —antes se lo tragaba en silencio, asi que
# OCR_MIN_TEXT_CHARS=8O con la letra O parecia funcionar—, y uno fuera de rango
# se recorta al extremo mas cercano. Nunca aborta el arranque: una variable
# opcional mal escrita no justifica dejar sin servicio.

# Version del prompt registrada en cada interacción del CSV.
PROMPT_VERSION=1

# Donde se escribe el registro de interacciones. Por defecto,
# backend/data/chat-interactions.csv. Las pruebas lo apuntan a un temporal para
# no contaminar el archivo real, del que extract-queries.ts saca las preguntas
# del conjunto dorado.
# La ruta HTTP ya NO espera esta escritura antes de responder (hallazgo M-7):
# medido con el CSV en su tamano real (1,1 MB), cada escritura cuesta 0,07 ms de
# mediana —la primera, 6,5 ms, porque lee el archivo entero para hallar el
# ultimo id—, asi que la ganancia de latencia es menor de lo que sugeria el
# hallazgo. Lo que si arregla es el aislamiento: un fallo al registrar ya no se
# convierte en un 503 para el ciudadano.
# Limite conocido, sin resolver: el ultimo id es estado del proceso, asi que dos
# instancias del backend sobre el mismo archivo siguen produciendo ids
# duplicados. Eso exige mover el registro a SQLite, fuera del alcance de M-7.
# CHAT_LOG_FILE=var/chat-interactions.csv
#
# PRIVACIDAD DEL REGISTRO (hallazgo A-11).
#
# El registro dejo de vivir en backend/data/ —que es GEOTRENDS_DOCUMENTS_ROOT y
# el arbol que se sincroniza entre equipos segun el README, asi que las
# conversaciones ciudadanas viajaban con el corpus—. Ahora el defecto es
# backend/var/, que no se indexa ni se comparte y esta en .gitignore.
#
# Lo que se escribe va ENMASCARADO: cedulas, NIT, correos, telefonos y
# matriculas inmobiliarias se sustituyen por una etiqueta antes de tocar el
# disco (src/services/pii.ts), y la migracion enmascara tambien el historico ya
# acumulado. Cada fila lleva fecha y un hash de la pregunta ya enmascarada, que
# permite agrupar repeticiones sin conservar el texto original.
#
# El enmascarado esta calibrado contra las 1.105 interacciones reales: la regla
# de "numero con separadores de miles" se retiro porque enmascaraba cifras
# presupuestales (43.109.692.812, $1.865.000) creyendolas documentos. Limite
# conocido y deliberado: una cedula escrita sin la palabra que la nombra no se
# enmascara. Vale mas un falso negativo que destruir contenido legitimo.
#
# Cuantos dias se conservan las interacciones. La Ley 1581 de 2012 exige un
# plazo explicito, no "para siempre". Al arrancar se purga lo vencido.
# CHAT_LOG_RETENTION_DAYS=90

# Embeddings locales E5 multilingüe: no requiere API key adicional.
# Caché de modelos y fragmentos (relativa al backend).
RETRIEVAL_CACHE_DIR=.cache/retrieval

# Preprocesamiento documental: Markdown cacheado y OCR local para PDF escaneado.
# Requiere: brew install tesseract tesseract-lang ocrmypdf
DOCUMENT_CACHE_DIR=.cache/documents
OCR_ENABLED=true
OCR_LANGUAGE=spa+eng
OCR_MIN_TEXT_CHARS=80
# OCR_COMMAND=ocrmypdf
# DOC_CONVERTER_COMMAND=soffice
# Endereza escaneos torcidos antes del OCR (mas preciso, ~30% mas lento por
# PDF escaneado). Ponlo en "false" solo si tu volumen de indexado es grande
# y tus escaneos ya vienen razonablemente derechos.
# OCR_DESKEW=true

# Cuando un PDF trae capa de texto pero es ILEGIBLE —430 documentos del corpus
# la tienen rota, y extraen "A AC CU UE ER RD DO O" con cada caracter
# duplicado—, se fuerza el OCR con --force-ocr en vez de --skip-text, que se
# saltaria justo las paginas que hay que rehacer. Si aun asi no sale nada
# utilizable, se indexa el texto nativo imperfecto antes que descartar el
# documento: un texto malo se puede buscar, uno ausente no.
#
# Si el primer intento de OCR da vacio o texto irreconocible como idioma
# (ver looksLikeGarbage en documentPreprocessor.ts), se reintenta una vez con
# --rotate-pages --clean --oversample 300 antes de rendirse. Arregla escaneos
# girados o de baja resolucion; NO arregla manuscritos -- Tesseract reconoce
# letra impresa, no escritura a mano.
#
# DESACTIVADO por defecto tras medirlo sobre el corpus real. Muestra aleatoria
# de 110 de los 2.213 PDF que disparan OCR:
#
#   pasada 1 exitosa        88/110 (80%)
#   pasada 2 ejecutada      22
#   pasada 2 "exitosa"       2 (9%) -- pero solo 1 de esos 2 da texto util:
#                              el otro (acuerdo-15-de-1926.pdf) es ruido que
#                              se cuela por el filtro de basura. Tasa real
#                              ~4,5%, a ~600 s por documento aprovechado.
#   tiempo pasada 1        925 s
#   tiempo pasada 2        595 s  (+64% sobre el total de OCR)
#
# El motivo del fallo es el corpus, no la configuracion: de los 418 documentos
# que fallan las dos pasadas, 416 son manuscritos de 1880-1929 del Concejo de
# Envigado. Ninguna config de ocrmypdf lee letra manuscrita. Extrapolado al
# corpus completo, el reintento cuesta ~3,3 h por reconstruccion en frio para
# recuperar fragmentos de ~20 documentos de 6.314.
#
# Ponlo en "true" si cambias de corpus a uno con escaneos impresos girados o
# de baja resolucion, donde esta segunda config si tiene de donde rescatar.
# Cambiar este valor NO invalida el indice ya construido: la clave de cache de
# search.ts no incluye la config de OCR, asi que solo afecta a documentos
# nuevos o modificados y a los rebuilds en frio.
OCR_RETRY_ENABLED=false

# Umbral de relevancia y abstencion (hallazgo A-5). El reranker (cross-encoder
# ms-marco) puntua cada candidato con un logit; por debajo de este valor se
# descarta antes de enviarse al LLM como si fuera evidencia real. Si TODOS los
# candidatos quedan por debajo, la consulta responde sin llamar a ningun
# proveedor (meta.abstained = true) en vez de fabricar una respuesta.
# Sin esta variable, NO se filtra nada (comportamiento identico al anterior a
# A-5): medido contra el reranker real, una pregunta parafraseada sin traslape
# de vocabulario con el documento correcto puntua igual de negativo (-10.4)
# que una pregunta genuinamente fuera de alcance (-11.2) -- un valor adivinado
# sin medir fabricaria abstenciones falsas. Calibrar con:
#   npm run eval:retrieval -- --sweep=-10,-8,-6,-4,-2,0
# contra el conjunto dorado de A-12 (test/fixtures/golden-set.json) y fijar
# aqui el valor mas alto que no baje recall@8 en los casos con respuesta real.
# Limite conocido: si el reranker falla y el sistema cae a solo RRF, no hay
# logit que filtrar -- el umbral NO se aplica en ese camino de reserva.
# MIN_RERANK_SCORE=

# Cuantos candidatos de la fusion RRF llegan al reranker (hallazgo A-1). El
# cross-encoder es el 82 % del tiempo de una consulta y su costo escala con el
# tamano del lote, asi que este numero es la palanca de velocidad mas directa
# que queda sin tocar la estructura del indice. Calibrar con:
#   npm run eval:retrieval -- --sweep-candidates=8,12,16,20
# que imprime calidad Y tiempo por consulta: el valor bueno es el mas bajo que
# no mueva recall@8. Mandar menos candidatos tambien deja menos de donde elegir
# a la diversificacion de A-6, asi que los dos se calibran juntos.
# RERANK_CANDIDATES=16

# Cuanto pesa la pregunta anterior frente a la actual en BM25, en preguntas de
# seguimiento (hallazgo M-2). Antes se concatenaban y todos los terminos de la
# pregunta anterior puntuaban igual que los de la actual. El motor semantico no
# ve la pregunta anterior en absoluto —E5 hace mean-pooling y mezclar dos temas
# desplaza el vector a un punto que no representa ninguno—; el reranker si la
# ve entera, porque lee texto y no sufre esa dilucion.
# RETRIEVAL_CONTEXT_WEIGHT=0.3

# Diversidad y deduplicacion del top-8 (hallazgo A-6). Cuantos fragmentos del
# MISMO documento pueden ocupar el top-8 antes de ceder el puesto a otro
# documento. Nunca devuelve menos resultados: si no hay alternativas, el cupo
# se rellena con lo descartado, asi que el resultado es identico al de antes.
# RETRIEVAL_MAX_PER_DOCUMENT=3

# A partir de que similitud de Jaccard (sobre 3-gramas de palabras) dos
# fragmentos cuentan como el mismo contenido. Calibrado contra el corpus real,
# no a ojo:
#   fragmentos CONSECUTIVOS del mismo documento (comparten 150 caracteres por
#     construccion de chunkText):   mediana 0,073 · p95 0,133 · max 0,211
#   fragmentos de documentos distintos de la misma familia (manuales con
#     secciones repetidas):         mediana 0,000 · p95 0,022 · max 0,857
#   copia exacta:                   1,000
# Con 0,6 no se marca ni uno solo de los 279 pares consecutivos medidos —queda
# casi 3x por encima del peor caso— y si se atrapan los duplicados reales.
# Bajarlo de 0,4 empieza a acercarse a la zona de falsos positivos.
# RETRIEVAL_NEAR_DUPLICATE_JACCARD=0.6

# Cuantos archivos se extraen (lectura/OCR) en paralelo mientras se embebe el
# anterior durante "npm run index". Por defecto 2; subirlo puede saturar CPU
# si muchos PDF necesitan OCR a la vez.
# DOCUMENT_EXTRACTION_CONCURRENCY=2

# Hilos ONNX para el pipeline de embeddings. El servidor en vivo (npm run dev
# / npm start) se queda en 2 para no competir con el chat; "npm run index"
# sube esto automaticamente (cpus - 1) si no se fija a mano.
# EMBEDDING_INTRA_OP_THREADS=2

# Cada cuanto se comprueba en segundo plano si los documentos cambiaron.
# Antes esa comprobacion se hacia dentro de CADA consulta y costaba ~178 ms.
# 0 = comprobar en cada consulta y esperar el resultado (comportamiento anterior;
# es lo que usan las pruebas que modifican documentos y consultan de inmediato).
# INDEX_REVALIDATE_MS=300000

# Fraccion del heap por encima de la cual NO se lanza una reconstruccion en
# segundo plano. Una reconstruccion mantiene vivo el indice anterior mientras
# arma el nuevo: medido con "npm run probe:rebuild", el sobrecoste ronda los
# 800 MB de material transitorio. Con el indice actual (532 MB) no se dispara;
# queda como red por si el corpus crece mucho. Si se supera, la revalidacion se
# aplaza y se avisa por consola; reindexa sin trafico con "npm run index".
# INDEX_REVALIDATE_MAX_HEAP_FRACTION=0.55

# Ejecuta la recuperacion (indice, embeddings y reranker) en un worker_thread,
# para que el hilo principal no se bloquee: sin el, 20 consultas concurrentes
# dejan a GET /health esperando hasta 1,6 s; con el, 0,6 ms en el p99.
# "false" la ejecuta en el hilo principal (es lo que usan las pruebas, que
# cambian variables de entorno a mitad de corrida y un worker no las veria).
# RETRIEVAL_WORKER=true

# Hilos que ONNX Runtime reparte dentro de UNA inferencia del reranker, que es
# el 80 % del tiempo de una consulta. El optimo NO es el numero de nucleos: en
# un Apple M4 (4 de rendimiento + 6 de eficiencia) esta en 4, y subir de ahi
# empeora por contencion. Los puntajes son identicos con cualquier valor, asi
# que ajustarlo no cambia ninguna respuesta. Calibralo con `npm run bench:rerank`
# en la maquina donde se despliegue.
# 0 (el valor por defecto) = automatico: min(4, nucleos disponibles). Asi una
# maquina sin configurar obtiene el optimo de SU hardware.
# RERANK_INTRA_OP_THREADS=0

# Cuantas consultas pueden estar esperando antes de empezar a rechazar con 503 y
# cabecera Retry-After. La recuperacion atiende de una en una —el reranker no se
# puede paralelizar dentro del proceso—, asi que sin tope una rafaga se encola
# sin limite y el servidor trabaja para clientes que ya cerraron la conexion.
# Con 24 y unos 400 ms por consulta, el ultimo de la cola espera unos 10 s.
# RETRIEVAL_MAX_QUEUE=24

# ═══════════════════════════════════════════════════════════════════════════
# SEGURIDAD DEL PERIMETRO (hallazgo C-1) -- OBLIGATORIO ANTES DE EXPONER
# ═══════════════════════════════════════════════════════════════════════════
#
# El API no tenia nada delante: cualquiera que alcanzara el puerto podia
# enumerar los 6.295 documentos, descargarlos y ejecutar /api/chat sin limite,
# con cuatro claves de API facturables detras.
#
# Modelo de identidad: el canal es PUBLICO, asi que no hay registro ni login.
# El backend emite una sesion ANONIMA (POST /api/session) que no identifica a
# una persona sino a un cliente -- lo justo para poner cuota y distinguir un
# navegador de un bucle de curl. El corpus documental queda en un alcance
# aparte, inaccesible para el usuario final.
#
# Clave de firma de los JWT. SIN ESTO EL SERVICIO NO ARRANCA EN PRODUCCION:
# un secreto por defecto es no tener autenticacion, solo que aparentandola.
# Minimo 32 caracteres. Generar con: openssl rand -base64 48
AUTH_JWT_SECRET=

# Vida del token de sesion, en segundos (60 a 86400). Por defecto 3600.
# AUTH_SESSION_TTL_SECONDS=3600

# Origenes permitidos para CORS, separados por coma. Vacio = ningun origen
# cruzado (el frontend servido desde el mismo host sigue funcionando).
# Antes era cors() sin argumentos, es decir Access-Control-Allow-Origin: *.
# ALLOWED_ORIGINS=https://geobot.envigado.gov.co

# Detras de un proxy inverso, para que los limites de tasa vean la IP real del
# cliente y no la del proxy. Valor de Express: "1", "loopback", una IP...
# TRUST_PROXY=1

# Presupuesto TOTAL de la cadena de fallback entre proveedores, en ms.
# Antes solo habia timeout POR proveedor: cuatro sumaban hasta 240 s, y ese era
# el ataque de denegacion de servicio mas barato posible.
# FALLBACK_BUDGET_MS=75000
