# ─────────────────────────────────────────────────────────────────────────────
# Geobot — configuración única (Docker y desarrollo local)
#
#   Docker:  cp .env.example .env            (en la raíz del repo)
#   Local:   cp .env.example backend/.env    (npm run dev / npm run index)
#
# Obligatorio: AUTH_JWT_SECRET y al menos una API key de proveedor. Todo lo
# demás tiene un valor por defecto razonable; al arrancar, el backend imprime
# qué variables vienen del entorno y cuáles usan su defecto.
#
# Las variables numéricas se leen por un camino validado (services/config.ts):
# un valor no numérico avisa por consola y cae al defecto, y uno fuera de rango
# se recorta. Nunca aborta el arranque.
#
# El frontend no necesita configuración: en Docker comparte origen con el API
# (nginx reenvía /api al backend) y en local usa http://localhost:3001/api/chat.
# ─────────────────────────────────────────────────────────────────────────────

# ── Obligatorio ──────────────────────────────────────────────────────────────

# Clave de firma de los JWT de sesión. Mínimo 32 caracteres.
# Generar con: openssl rand -base64 48
# En producción (y en Docker) el servicio NO arranca sin esto; en desarrollo
# local usa un secreto efímero y avisa (los tokens no sobreviven a un reinicio).
AUTH_JWT_SECRET=

# ── Docker Compose (make up / make scrape / make cache) ──────────────────────
#
# Solo los lee docker-compose.yml; el backend las ignora.

# Puerto del host donde queda la aplicación (UI y API bajo /api).
FRONTEND_PORT=8080

# Dónde vive el corpus descargado por el scraper. Vacío = volumen Docker
# "geobot-data" (recomendado). Una ruta del host (p. ej. ./backend/data)
# reutiliza un corpus ya descargado; en Linux debe pertenecer al UID 10001:
#   sudo chown -R 10001:10001 <ruta>
# DATA_DIR=

# Fuentes que recorre "make scrape", separadas por espacio.
SCRAPER_SOURCES=ambientometro concejo_envigado minambiente minagricultura envigado_com gmas2_envigado

# ── Solo desarrollo local (en Docker las fija docker-compose.yml) ────────────

# Puerto del backend. 3001 es el que espera el frontend en `npm run dev`.
PORT=3001

# Carpeta local con el corpus (recursiva). Relativa al backend o absoluta.
GEOTRENDS_DOCUMENTS_ROOT=data

# ── Proveedores ──────────────────────────────────────────────────────────────
#
# Convención para todos: *_MODEL es el modelo por defecto y *_MODELS el
# catálogo permitido, separado por comas. El backend rechaza cualquier modelo
# recibido que no esté en el catálogo de su proveedor.
#
# Basta con configurar uno. Los que queden sin API key aparecen deshabilitados
# en el selector de la interfaz.

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODELS=gemini-flash-latest

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODELS=llama-3.1-8b-instant

# DeepSeek — https://platform.deepseek.com/api_keys (API compatible OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODELS=deepseek-v4-flash
# Por defecto https://api.deepseek.com/chat/completions
# DEEPSEEK_API_URL=

# OpenAI — https://platform.openai.com/api-keys
# Los modelos de razonamiento (familia gpt-5) fijan la temperatura por su
# cuenta; el backend no envía un valor propio.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_MODELS=gpt-5-nano

# Ollama — servicio local, no necesita API key
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_MODELS=llama3.2
# Espera máxima (defecto 120000). Más generosa que los 60 s de los proveedores
# remotos porque Ollama genera en la CPU de esta misma máquina.
# OLLAMA_TIMEOUT_MS=120000

# ── Enrutamiento automático ──────────────────────────────────────────────────
#
# Qué proveedor y modelo atiende cada nivel de complejidad de pregunta. Cada
# modelo debe estar también en el *_MODELS de su proveedor. El respaldo entra
# si el principal no está configurado o devuelve un error conocido.

AUTO_ROUTE_SIMPLE_PROVIDER=groq
AUTO_ROUTE_SIMPLE_MODEL=llama-3.1-8b-instant
AUTO_ROUTE_SIMPLE_FALLBACK_PROVIDER=gemini
AUTO_ROUTE_SIMPLE_FALLBACK_MODEL=gemini-flash-latest

AUTO_ROUTE_MEDIUM_PROVIDER=groq
AUTO_ROUTE_MEDIUM_MODEL=llama-3.1-8b-instant
AUTO_ROUTE_MEDIUM_FALLBACK_PROVIDER=gemini
AUTO_ROUTE_MEDIUM_FALLBACK_MODEL=gemini-flash-latest

AUTO_ROUTE_COMPLEX_PROVIDER=deepseek
AUTO_ROUTE_COMPLEX_MODEL=deepseek-v4-flash
AUTO_ROUTE_COMPLEX_FALLBACK_PROVIDER=gemini
AUTO_ROUTE_COMPLEX_FALLBACK_MODEL=gemini-flash-latest

# Presupuesto TOTAL de la cadena de fallback, en ms (defecto 75000, rango
# 5000-300000). Sin él, cuatro timeouts por proveedor sumaban hasta 240 s.
# FALLBACK_BUDGET_MS=75000

# Reintentos ante fallos transitorios. Solo se repite lo reintentable: red, 5xx
# y 429. Un 401 o un modelo inexistente se devuelven al primer intento.
# ATTEMPTS son intentos TOTALES, no reintentos: 2 = uno y, si falla, otro.
# Si el proveedor manda Retry-After se respeta, acotado por MAX_MS.
# PROVIDER_RETRY_ATTEMPTS=2      # rango 1-5
# PROVIDER_RETRY_BASE_MS=500     # rango 0-30000
# PROVIDER_RETRY_MAX_MS=4000     # rango 0-60000

# ── Seguridad del perímetro ──────────────────────────────────────────────────
#
# El canal es público: no hay registro ni login. El backend emite una sesión
# ANÓNIMA (POST /api/session) que no identifica a una persona sino a un
# cliente, lo justo para poner cuota y distinguir un navegador de un bucle de
# curl.

# Vida del token de sesión, en segundos (defecto 3600, rango 60-86400).
# AUTH_SESSION_TTL_SECONDS=3600

# Orígenes permitidos para CORS, separados por coma. Vacío = ningún origen
# cruzado (el frontend servido desde el mismo host sigue funcionando).
# Necesario en desarrollo local, donde el frontend corre en otro puerto.
# En Docker no hace falta: UI y API comparten origen.
# ALLOWED_ORIGINS=http://localhost:3000

# Detrás de un proxy inverso, para que los límites de tasa vean la IP real del
# cliente y no la del proxy. Valor de Express: "1", "loopback", una IP...
# En Docker vale 1 por defecto (el nginx del frontend); súbelo a 2 si además
# hay un balanceador o proxy inverso delante.
# TRUST_PROXY=1

# Máximo de caracteres de una pregunta. El frontend usa 2500 como límite de
# interfaz y el backend conserva siempre la validación autoritativa.
# CHAT_MAX_MESSAGE_CHARS=2500

# Cuotas de consultas que sí obtuvieron plaza de ejecución. Se reinician al
# cambiar el día UTC. El límite global protege el presupuesto total; el límite
# por IP evita que una sola red lo consuma completo.
# CHAT_DAILY_PER_IP_LIMIT=100
# CHAT_DAILY_GLOBAL_LIMIT=1000

# Hitos del cupo global que escriben una advertencia una sola vez por día.
# Lista de porcentajes enteros entre 1 y 100.
# CHAT_DAILY_ALERT_PERCENTAGES=10,25,50,75,90,100

# Más de 10 preguntas de más de 1500 caracteres desde una IP, dentro de una
# hora móvil, bloquean /api/chat para esa IP durante 24 horas.
# CHAT_LONG_MESSAGE_CHARS=1500
# CHAT_LONG_MESSAGE_HOURLY_LIMIT=10
# CHAT_LONG_MESSAGE_BLOCK_HOURS=24

# Cola FIFO del ciclo completo (recuperación + proveedor). Al llenarse o vencer
# la espera responde 503 con Retry-After; no consume cuota diaria.
# CHAT_MAX_CONCURRENT=4
# CHAT_MAX_QUEUE=24
# CHAT_QUEUE_TIMEOUT_MS=30000

# Persistencia de cuotas y bloqueos. En Docker vive en el volumen /app/var.
# Solo es válida para una réplica; varias réplicas requieren un store común.
# CHAT_LIMIT_STATE_FILE=var/chat-traffic-state.json

# ── Registro de interacciones ────────────────────────────────────────────────
#
# Se escribe en backend/var/ — fuera del árbol de documentos, que se sincroniza
# entre equipos — y va ENMASCARADO: cédulas, NIT, correos, teléfonos y
# matrículas inmobiliarias se sustituyen por una etiqueta antes de tocar el
# disco (services/pii.ts). Cada fila lleva fecha y un hash de la pregunta ya
# enmascarada, que permite agrupar repeticiones sin guardar el texto original.
#
# El enmascarado prefiere un falso negativo a destruir contenido legítimo: el
# corpus está lleno de números que parecen documentos de identidad y no lo son
# ("Ley 1581 de 2012", cifras presupuestales). Una cédula escrita sin la
# palabra que la nombra no se enmascara.

# Versión del prompt registrada en cada fila.
PROMPT_VERSION=1

# Dónde se escribe. Por defecto backend/var/chat-interactions.csv; en Docker,
# el volumen geobot-var.
# Las pruebas lo apuntan a un temporal para no contaminar el archivo real.
# CHAT_LOG_FILE=var/chat-interactions.csv

# Días de retención antes de purgar (defecto 90, rango 1-3650). La Ley 1581 de
# 2012 exige un plazo explícito. Se purga lo vencido al arrancar.
# CHAT_LOG_RETENTION_DAYS=90

# ── Preprocesamiento y OCR ───────────────────────────────────────────────────
#
# En local requiere: brew install tesseract tesseract-lang ocrmypdf
# y LibreOffice para convertir los .doc heredados. La imagen Docker ya los trae.

# Markdown derivado de cada documento. En Docker: volumen geobot-cache.
DOCUMENT_CACHE_DIR=.cache/documents
OCR_ENABLED=true
OCR_LANGUAGE=spa+eng
# Caracteres por debajo de los cuales un PDF se considera escaneado (defecto 80).
OCR_MIN_TEXT_CHARS=80

# Binarios, si no están en el PATH con su nombre habitual.
# OCR_COMMAND=ocrmypdf
# DOC_CONVERTER_COMMAND=soffice

# Endereza escaneos torcidos antes de reconocer: más preciso, ~30 % más lento
# por PDF escaneado (defecto true).
# OCR_DESKEW=true

# Segunda pasada de OCR (--rotate-pages --clean --oversample 300) cuando la
# primera no da texto reconocible. DESACTIVADA por defecto: medida sobre el
# corpus real, rescata ~1 documento útil de cada 22 a cambio de +64 % de tiempo
# de OCR. El motivo del fallo es el corpus, no la configuración — casi todo lo
# que falla son manuscritos de 1880-1929, y Tesseract no lee letra a mano.
# Actívala si cambias a un corpus con escaneos impresos girados o de baja
# resolución. Cambiar este valor no invalida el índice ya construido.
OCR_RETRY_ENABLED=false

# Archivos extraídos en paralelo mientras se embebe el anterior durante
# "npm run index" (defecto 2, rango 1-16). Subirlo puede saturar la CPU si
# muchos PDF necesitan OCR a la vez.
# DOCUMENT_EXTRACTION_CONCURRENCY=2

# ── Índice y recuperación ────────────────────────────────────────────────────
#
# Embeddings locales E5 multilingüe: no requieren API key ni envían los
# documentos a ningún servicio externo.

# Índice y modelos descargados. En Docker: volumen geobot-cache.
RETRIEVAL_CACHE_DIR=.cache/retrieval

# Cada cuánto se comprueba en segundo plano si el corpus cambió (defecto
# 300000 ms). 0 = comprobar dentro de cada consulta y esperar el resultado;
# es lo que usan las pruebas que modifican documentos y consultan de inmediato.
# INDEX_REVALIDATE_MS=300000

# Fracción del heap por encima de la cual no se lanza una reconstrucción en
# segundo plano (defecto 0.55). Una reconstrucción mantiene vivo el índice
# anterior mientras arma el nuevo, con unos 800 MB de material transitorio. Si
# se supera, la revalidación se aplaza y se avisa; reindexa sin tráfico con
# "npm run index".
# INDEX_REVALIDATE_MAX_HEAP_FRACTION=0.55

# Ejecuta la recuperación en un worker_thread para no bloquear el hilo
# principal (defecto true). Con "false" corre en el hilo principal: es lo que
# usan las pruebas, que cambian variables de entorno en caliente.
# RETRIEVAL_WORKER=true

# Consultas que pueden esperar antes de rechazar con 503 y Retry-After
# (defecto 24). La recuperación atiende de una en una porque el reranker no se
# paraleliza dentro del proceso; sin tope, una ráfaga se encola sin límite.
# RETRIEVAL_MAX_QUEUE=24

# ── Calidad de la recuperación ───────────────────────────────────────────────

# Cuántos candidatos de la fusión RRF llegan al reranker (defecto 16, rango
# 1-64). Es la palanca de velocidad más directa: el cross-encoder es ~82 % del
# tiempo de una consulta y su costo escala con el tamaño del lote. Calibrar con
#   npm run eval:retrieval -- --sweep-candidates=8,12,16,20
# y quedarse con el valor más bajo que no mueva recall@8.
# RERANK_CANDIDATES=16

# Umbral de relevancia y abstención. Por debajo de este logit un candidato se
# descarta; si todos quedan por debajo, la consulta responde sin llamar a
# ningún proveedor (meta.abstained = true) en vez de fabricar una respuesta.
# SIN esta variable no se filtra nada, que es el defecto deliberado: un valor
# adivinado sin medir fabrica abstenciones falsas. Calibrar con
#   npm run eval:retrieval -- --sweep=-10,-8,-6,-4,-2,0
# contra test/fixtures/golden-set.json y fijar el valor más alto que no baje
# recall@8. No se aplica si el reranker falla y el sistema cae a solo RRF.
# MIN_RERANK_SCORE=

# Cuánto pesa la pregunta anterior frente a la actual en BM25, en preguntas de
# seguimiento (defecto 0.3, rango 0-1). El motor semántico no ve la pregunta
# anterior en absoluto; el reranker sí la ve entera.
# RETRIEVAL_CONTEXT_WEIGHT=0.3

# Cuántos fragmentos del MISMO documento pueden ocupar el top-8 antes de ceder
# el puesto a otro documento (defecto 3, rango 1-8). Nunca devuelve menos
# resultados: si no hay alternativas, el cupo se rellena con lo descartado.
# RETRIEVAL_MAX_PER_DOCUMENT=3

# A partir de qué similitud de Jaccard (sobre 3-gramas de palabras) dos
# fragmentos cuentan como el mismo contenido (defecto 0.6, rango 0.05-1).
# Calibrado contra el corpus: los fragmentos consecutivos del mismo documento,
# que comparten 150 caracteres por construcción, llegan como mucho a 0,21.
# Bajarlo de 0,4 entra en zona de falsos positivos.
# RETRIEVAL_NEAR_DUPLICATE_JACCARD=0.6

# ── Rendimiento de inferencia ────────────────────────────────────────────────
#
# Ninguna de estas dos cambia un solo resultado: solo mueven el tiempo.

# Hilos que ONNX Runtime reparte dentro de UNA inferencia del reranker.
# El óptimo NO es el número de núcleos — en un Apple M4 está en 4, y subir de
# ahí empeora por contención. 0 (defecto) = automático: min(4, núcleos).
# Calibrar en la máquina de despliegue con: npm run bench:rerank
# RERANK_INTRA_OP_THREADS=0

# Hilos del pipeline de embeddings (defecto 2, rango 1-64). El servidor en vivo
# se queda en 2 para no competir con el chat; "npm run index" lo sube
# automáticamente a (núcleos - 1) si no se fija a mano.
# EMBEDDING_INTRA_OP_THREADS=2
